# ============================================================
# FinProof 环境变量示例（复制为 .env 使用，所有项均有默认值，
# 不配置也能运行：后端默认 SQLite + LLM Mock 模式）
# ============================================================

# --- 后端 ---
# SQLite 数据库文件路径（sqlite:/// 相对路径以 backend/ 为工作目录）
FINPROOF_DATABASE_URL=sqlite:///../data/finproof.db

# 上传文件、演示数据与原始文件存储目录
FINPROOF_UPLOAD_DIR=../data/uploads
FINPROOF_DEMO_DIR=../data/demo
FINPROOF_STORAGE_DIR=../storage

# 单文件上传大小上限（MB）
FINPROOF_MAX_UPLOAD_SIZE_MB=50

# 大模型模式：mock（默认，无 API Key 时使用，结果带"Mock"标识）
#            real（调用真实大模型，需 API Key）
#            off  （完全关闭语义类任务）
FINPROOF_LLM_MODE=mock
FINPROOF_LLM_API_KEY=
FINPROOF_LLM_MODEL=

# --- 主张提取（Phase 3）---
# mock：规则候选提取并明确标识 Mock；llm：调用真实大模型（openai_compatible）
FINPROOF_CLAIM_EXTRACTION_MODE=mock
FINPROOF_CLAIM_EXTRACTION_PROVIDER=openai_compatible
FINPROOF_CLAIM_EXTRACTION_MODEL=
FINPROOF_CLAIM_EXTRACTION_BASE_URL=
FINPROOF_CLAIM_EXTRACTION_API_KEY=
FINPROOF_CLAIM_EXTRACTION_TIMEOUT_SECONDS=60
FINPROOF_CLAIM_EXTRACTION_MAX_RETRIES=2
FINPROOF_CLAIM_EXTRACTION_PROMPT_VERSION=v1
